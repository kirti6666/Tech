# ─────────────────────────────────────────────────────────────
# TechBro — environment variables
#
# Copy to .env.local and fill in. Anything marked REQUIRED will
# break a customer-facing path if it's missing, usually after
# money has already changed hands.
#
# NEXT_PUBLIC_* values are visible in the browser. Never put a
# secret behind that prefix.
# ─────────────────────────────────────────────────────────────

# --- Core -----------------------------------------------------
# REQUIRED
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/techbro
# REQUIRED — used in emails, sitemap, structured data and payment
# redirect URLs. A wrong value here silently breaks every link you
# send to a customer.
NEXT_PUBLIC_SITE_URL=https://techbro.in
NEXTAUTH_URL=https://techbro.in
# Same public URL for links in appointment and service emails.
NEXT_PUBLIC_APP_URL=https://techbro.in
# REQUIRED — openssl rand -base64 32 for each. These three are DIFFERENT
# secrets and all three are read at import time: a missing one fails the
# build, not just a request.
NEXTAUTH_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Payments: Razorpay (India, INR) --------------------------
# REQUIRED for Indian orders
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# REQUIRED — without it the webhook rejects everything and no
# order is ever confirmed
RAZORPAY_WEBHOOK_SECRET=

# --- Payments: Stripe (international, USD) --------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Rupees per US dollar. Set deliberately with a margin — see
# lib/stripe.ts. Review when the rate moves a few percent.
INR_PER_USD=88

# --- Private file storage (S3 or Cloudflare R2) ---------------
# REQUIRED — downloads 503 after payment without these
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2: https://<account-id>.r2.cloudflarestorage.com — omit for S3
STORAGE_ENDPOINT=
# "auto" for R2, a real region for S3
STORAGE_REGION=auto

# --- Credential encryption ------------------------------------
# REQUIRED — openssl rand -base64 32
# Must decode to exactly 32 bytes. Deployment intake refuses to
# store anything without it. Keep OUT of database backups.
CREDENTIALS_ENCRYPTION_KEY=

# --- Email ----------------------------------------------------
# REQUIRED — licence delivery, invoices, password resets
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="TechBro <hello@techbro.in>"
# Where new orders, enquiries and intake submissions land
ADMIN_NOTIFICATION_EMAIL=

# --- Appointment booking -------------------------------------
# Defaults to ADMIN_NOTIFICATION_EMAIL.
APPOINTMENT_ADMIN_EMAIL=
# Quick setup: paste a link created with Google Meet's "Create a meeting
# for later" option. OAuth below is preferred when every booking needs a
# separate meeting link.
GOOGLE_MEET_URL=
# OAuth credentials authorized for the narrow Meet API scope:
# https://www.googleapis.com/auth/meetings.space.created
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=

# --- Rate limiting --------------------------------------------
# Strongly recommended in production. Without Redis the limiter is
# per-process, so on serverless the effective limit multiplies by
# the number of running instances — i.e. it's decorative.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled jobs -------------------------------------------
# REQUIRED for the credential purge and backup crons to run
CRON_SECRET=

# --- Optional -------------------------------------------------
# Fine-grained PAT, Administration: read/write on product repos.
# Needed for repo invitations and revoking them on refund.
GITHUB_TOKEN=

# WhatsApp order alerts (Meta Cloud API). Needs a pre-approved
# template with three body variables.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NOTIFY_NUMBER=
WHATSAPP_TEMPLATE_NAME=
# Public floating contact button. Include country code, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE="Hi TechBro, I would like to know more about your software products."

# Analytics. Leave blank in development so local clicks don't
# pollute production numbers.
NEXT_PUBLIC_GA_ID=

# Product screenshots (source archives use STORAGE_* above)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seeding (local only) -------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
